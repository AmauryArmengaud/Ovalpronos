SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# API rugby-live-data (RapidAPI)
RAPIDAPI_KEY=your-rapidapi-key

# Sync endpoint — doit correspondre au secret GitHub Actions SYNC_SECRET_TOKEN
SYNC_SECRET_TOKEN=your-sync-secret-token

# Base de données (laisser vide pour SQLite en dev)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email via Brevo (django-anymail). En dev, laisser vide : backend console par défaut
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=your-brevo-api-key
